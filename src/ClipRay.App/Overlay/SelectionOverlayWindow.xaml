<Window x:Class="ClipRay.App.Overlay.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipRay.App.Overlay"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Black" Cursor="Cross" Focusable="True"
        PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:OverlayTool.Move}" Executed="OnOverlayToolExecuted" />
        <CommandBinding Command="{x:Static local:OverlayTool.Pen}" Executed="OnOverlayToolExecuted" />
        <CommandBinding Command="{x:Static local:OverlayTool.Mosaic}" Executed="OnOverlayToolExecuted" />
        <CommandBinding Command="{x:Static local:OverlayTool.Picker}" Executed="OnOverlayToolExecuted" />
        <CommandBinding Command="{x:Static local:OverlayTool.ExtractText}" Executed="OnOverlayToolExecuted" />
        <CommandBinding Command="{x:Static local:OverlayTool.LongCapture}" Executed="OnOverlayToolExecuted" />
        <CommandBinding Command="{x:Static local:OverlayTool.Translate}" Executed="OnOverlayToolExecuted" />
        <CommandBinding Command="{x:Static local:OverlayTool.LiveTranslate}" Executed="OnOverlayToolExecuted" />
        <CommandBinding Command="{x:Static local:OverlayTool.Record}" Executed="OnOverlayToolExecuted" />
        <CommandBinding Command="{x:Static local:OverlayTool.Undo}" Executed="OnOverlayToolExecuted" />
        <CommandBinding Command="{x:Static local:OverlayTool.Cancel}" Executed="OnOverlayToolExecuted" />
        <CommandBinding Command="{x:Static local:OverlayTool.Confirm}" Executed="OnOverlayToolExecuted" />
    </Window.CommandBindings>
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="44" /><Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="2,0" /><Setter Property="Foreground" Value="#EDF1FA" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#344159" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#405B78" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="#EDF2FA" />
            <Setter Property="Background" Value="#181D27" />
            <Setter Property="BorderBrush" Value="#48546A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#EDF2FA" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid MinWidth="190">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Path x:Name="CheckGlyph" Data="M3,8 L7,12 L14,4" Stroke="#6ED7FF" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#2D3A50" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AnnotationMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItemStyle}">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid MinWidth="112">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Path x:Name="CheckGlyph" Data="M2,7 L5,10 L11,3" Stroke="#6ED7FF" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#2D3A50" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AnnotationMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
                <Border Height="1" Background="#3A465D" Margin="8,4" />
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Handle" TargetType="Ellipse">
            <Setter Property="Width" Value="11" /><Setter Property="Height" Value="11" />
            <Setter Property="Fill" Value="#F7F9FD" /><Setter Property="Stroke" Value="#44A7FF" /><Setter Property="StrokeThickness" Value="2" />
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EAF0FA" /><Setter Property="Background" Value="#273142" />
            <Setter Property="BorderBrush" Value="#3A465D" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#303B50" /><Setter TargetName="Surface" Property="BorderBrush" Value="#52627D" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#3B4962" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Image x:Name="FrozenImage" Stretch="Fill" IsHitTestVisible="False" />
        <Canvas x:Name="TranslationLayer" IsHitTestVisible="False" Visibility="Collapsed" />
        <Canvas x:Name="OverlayCanvas" Background="Transparent">
            <Image x:Name="EditPreview" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed" />
            <Canvas x:Name="ActiveEditPreview" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
                <Polyline x:Name="LivePen" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse x:Name="LivePenDot" Visibility="Collapsed" />
                <Path x:Name="LiveShape" />
                <Ellipse x:Name="ArrowOriginDot" Stroke="White" StrokeThickness="1.5" Visibility="Collapsed" />
            </Canvas>
            <Border x:Name="DimLeft" Background="#99000000" IsHitTestVisible="False" />
            <Border x:Name="DimTop" Background="#99000000" IsHitTestVisible="False" />
            <Border x:Name="DimRight" Background="#99000000" IsHitTestVisible="False" />
            <Border x:Name="DimBottom" Background="#99000000" IsHitTestVisible="False" />

            <Border x:Name="SelectionBorder" BorderBrush="#2EA6FF" BorderThickness="2" Background="Transparent" Visibility="Collapsed" />
            <Ellipse x:Name="MosaicBrushCursor" Stroke="#F5F8FF" StrokeThickness="1.5" Fill="#18FFFFFF"
                     IsHitTestVisible="False" Visibility="Collapsed" />

            <Ellipse x:Name="TopLeftHandle" Tag="TopLeft" Cursor="SizeNWSE" Style="{StaticResource Handle}" Visibility="Collapsed" />
            <Ellipse x:Name="TopHandle" Tag="Top" Cursor="SizeNS" Style="{StaticResource Handle}" Visibility="Collapsed" />
            <Ellipse x:Name="TopRightHandle" Tag="TopRight" Cursor="SizeNESW" Style="{StaticResource Handle}" Visibility="Collapsed" />
            <Ellipse x:Name="RightHandle" Tag="Right" Cursor="SizeWE" Style="{StaticResource Handle}" Visibility="Collapsed" />
            <Ellipse x:Name="BottomRightHandle" Tag="BottomRight" Cursor="SizeNWSE" Style="{StaticResource Handle}" Visibility="Collapsed" />
            <Ellipse x:Name="BottomHandle" Tag="Bottom" Cursor="SizeNS" Style="{StaticResource Handle}" Visibility="Collapsed" />
            <Ellipse x:Name="BottomLeftHandle" Tag="BottomLeft" Cursor="SizeNESW" Style="{StaticResource Handle}" Visibility="Collapsed" />
            <Ellipse x:Name="LeftHandle" Tag="Left" Cursor="SizeWE" Style="{StaticResource Handle}" Visibility="Collapsed" />
            <TextBox x:Name="AnnotationTextEditor" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Segoe UI" Padding="0" BorderThickness="0" Background="#30181D27"
                     Foreground="#FFFF4D4F" TextChanged="OnAnnotationTextChanged" />

            <Border x:Name="Toolbar" Padding="8,6" Background="#F0181D27" BorderBrush="#5A667A"
                    BorderThickness="1" CornerRadius="11" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SizeButton" MinWidth="104" Height="38" Margin="0,0,2,0" Style="{StaticResource MiniButton}"
                            ToolTip="自定义选区尺寸" Click="OnToggleSizeEditor">
                        <TextBlock x:Name="SizeLabel" Foreground="#E8EDF6" FontFamily="{StaticResource AppFont}"
                                   FontSize="13" VerticalAlignment="Center" TextAlignment="Center" />
                    </Button>
                    <Border Width="1" Height="26" Margin="4,0,5,0" Background="#465166" />

                    <Button x:Name="MoveToolButton" Style="{StaticResource ToolButton}" ToolTip="移动（锁定尺寸）" Command="{x:Static local:OverlayTool.Move}">
                        <Viewbox Width="23" Height="23"><Path Stroke="#EDF1FA" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,2 L12,22 M2,12 L22,12 M12,2 L9,5 M12,2 L15,5 M12,22 L9,19 M12,22 L15,19 M2,12 L5,9 M2,12 L5,15 M22,12 L19,9 M22,12 L19,15" /></Viewbox>
                    </Button>
                    <StackPanel x:Name="CaptureEditingTools" Orientation="Horizontal">
                    <Button x:Name="AnnotationToolButton" Style="{StaticResource ToolButton}" Width="51" ToolTip="标注工具" Click="OnAnnotationMenu">
                        <Grid><Viewbox Width="23" Height="23" Margin="0,0,8,0"><Path x:Name="PenGlyph" Stroke="#EDF1FA" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M4,20 L5.5,14.5 L16.5,3.5 C17.3,2.7 18.5,2.7 19.3,3.5 L20.5,4.7 C21.3,5.5 21.3,6.7 20.5,7.5 L9.5,18.5 Z M14.5,5.5 L18.5,9.5 M4,20 L9.5,18.5" /></Viewbox>
                            <Path Data="M0,0 L3,3 L6,0" Stroke="#B7C0D1" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="马赛克" Command="{x:Static local:OverlayTool.Mosaic}">
                        <Viewbox Width="23" Height="23">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" RadiusX="5" RadiusY="5" Stroke="#EDF1FA" StrokeThickness="1.7" />
                                <Path Fill="#EDF1FA" Data="M2,7 A5,5 0 0 1 7,2 H12 V12 H2 Z M12,12 H22 V17 A5,5 0 0 1 17,22 H12 Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="取色" Command="{x:Static local:OverlayTool.Picker}">
                        <Viewbox Width="23" Height="23"><Canvas Width="24" Height="24">
                            <Path x:Name="PickerGlyph" Stroke="#EDF1FA" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M12,9 L3.586,17.414 A2,2 0 0 0 3,18.828 V20.172 A2,2 0 0 1 2.414,21.586 A2,2 0 0 1 3.828,21 H5.172 A2,2 0 0 0 6.586,20.414 L15,12" />
                            <Path Stroke="#EDF1FA" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M18,9 L18.4,9.4 A1,1 0 1 1 15.4,12.4 L11.6,8.6 A1,1 0 1 1 14.6,5.6 L15,6 L18.4,2.6 A1,1 0 1 1 21.4,5.6 Z" />
                            <Path Stroke="#EDF1FA" StrokeThickness="2" StrokeStartLineCap="Round" Data="M2,22 L2.414,21.586" />
                        </Canvas></Viewbox>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="长截图" Command="{x:Static local:OverlayTool.LongCapture}">
                        <Viewbox Width="23" Height="23"><Canvas x:Name="LongCaptureGlyph" Width="24" Height="24">
                            <Rectangle Canvas.Left="4" Canvas.Top="2.5" Width="16" Height="7" RadiusX="1.5" RadiusY="1.5" Stroke="#EDF1FA" StrokeThickness="1.7" />
                            <Rectangle Canvas.Left="4" Canvas.Top="14.5" Width="16" Height="7" RadiusX="1.5" RadiusY="1.5" Stroke="#EDF1FA" StrokeThickness="1.7" />
                            <Path Stroke="#EDF1FA" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M12,8.5 V15.5 M8.5,12 L12,15.5 L15.5,12" />
                        </Canvas></Viewbox>
                    </Button>
                    <Button x:Name="TranslateToolButton" Style="{StaticResource ToolButton}" ToolTip="翻译（右键临时切换模型）"
                            Command="{x:Static local:OverlayTool.Translate}" PreviewMouseRightButtonUp="OnTranslateToolRightClick">
                        <Viewbox Width="23" Height="23"><Path x:Name="TranslateGlyph" Stroke="#EDF1FA" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Data="M5,8 L11,14 M4,14 L10,8 L12,5 M2,5 H14 M7,2 H8 M22,22 L17,12 L12,22 M14,18 H20" /></Viewbox>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Width="78" ToolTip="实时翻译当前选区（页面不会冻结）" AutomationProperties.Name="实时翻译当前选区"
                            Command="{x:Static local:OverlayTool.LiveTranslate}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="23" Height="23"><Canvas Width="24" Height="24">
                            <Path Stroke="#EDF1FA" StrokeThickness="1.7" StrokeLineJoin="Round"
                                  Data="M3,5 H15 V15 H3 Z M9,9 H21 V19 H9" />
                            <Path Stroke="#66D9FF" StrokeThickness="1.7" StrokeStartLineCap="Round"
                                  Data="M5,9 H13 M11,7 L13,9 L11,11" />
                        </Canvas></Viewbox>
                        <TextBlock Text="实时" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#EDF1FA" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="文字提取" Command="{x:Static local:OverlayTool.ExtractText}">
                        <Viewbox Width="23" Height="23"><Path Stroke="#EDF1FA" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,3 H9 M4,3 V8 M20,3 H15 M20,3 V8 M4,21 H9 M4,21 V16 M20,21 H15 M20,21 V16 M8,8 H16 M12,8 V17 M9,17 H15" /></Viewbox>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="录屏" Command="{x:Static local:OverlayTool.Record}">
                        <Viewbox Width="23" Height="23"><Path x:Name="RecordGlyph" Fill="#EDF1FA"
                            Data="F0 M5.25,5 A3.25,3.25 0 0 0 2,8.25 V15.75 A3.25,3.25 0 0 0 5.25,19 H13.75 A3.25,3.25 0 0 0 17,15.75 V15.567 L19.555,17.271 A1.575,1.575 0 0 0 22,15.96 V8.04 A1.575,1.575 0 0 0 19.555,6.729 L17,8.433 V8.25 A3.25,3.25 0 0 0 13.75,5 Z M17,10.236 L20.387,7.978 A0.075,0.075 0 0 1 20.5,8.041 V15.959 A0.075,0.075 0 0 1 20.387,16.022 L17,13.764 Z M3.5,8.25 A1.75,1.75 0 0 1 5.25,6.5 H13.75 A1.75,1.75 0 0 1 15.5,8.25 V15.75 A1.75,1.75 0 0 1 13.75,17.5 H5.25 A1.75,1.75 0 0 1 3.5,15.75 Z">
                            <Path.RenderTransform><TranslateTransform x:Name="RecordGlyphTransform" Y="-0.75" /></Path.RenderTransform>
                        </Path></Viewbox>
                    </Button>
                    <Border Width="1" Height="26" Margin="5,0" Background="#465166" />
                    <Button Style="{StaticResource ToolButton}" ToolTip="撤回" Command="{x:Static local:OverlayTool.Undo}">
                        <Viewbox Width="23" Height="23"><Path Stroke="#EDF1FA" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M9,6 L4,11 L9,16 M5,11 H14 C19,11 21,15 20,20" /></Viewbox>
                    </Button>
                    </StackPanel>
                    <Button x:Name="CancelToolButton" Style="{StaticResource ToolButton}" Width="52" ToolTip="取消" Command="{x:Static local:OverlayTool.Cancel}">
                        <Viewbox Width="28" Height="28"><Path Stroke="#FF6D72" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M5,5 L23,23 M23,5 L5,23" /></Viewbox>
                    </Button>
                    <Button x:Name="ConfirmToolButton" Style="{StaticResource ToolButton}" Width="52" ToolTip="确认（Enter）" Command="{x:Static local:OverlayTool.Confirm}">
                        <Viewbox Width="28" Height="28"><Path Stroke="#5EE0A0" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M4,15 L11,22 L24,6" /></Viewbox>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="ToolProperties" Padding="12,8" Background="#F0181D27" BorderBrush="#5A667A"
                    BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel x:Name="PenProperties" Orientation="Horizontal" Visibility="Collapsed">
                        <Border x:Name="SelectedPenColor" Width="26" Height="26" Margin="0,0,7,0" CornerRadius="6" Background="#FFFF4D4F" BorderBrush="#88FFFFFF" BorderThickness="1" />
                        <Button Width="24" Height="24" Margin="2" Padding="0" Background="#FFFF4D4F" BorderThickness="0" Tag="#FF4D4F" Click="OnPresetColor" ToolTip="红色" />
                        <Button Width="24" Height="24" Margin="2" Padding="0" Background="#FFFF9F43" BorderThickness="0" Tag="#FF9F43" Click="OnPresetColor" ToolTip="橙色" />
                        <Button Width="24" Height="24" Margin="2" Padding="0" Background="#FFFFD93D" BorderThickness="0" Tag="#FFD93D" Click="OnPresetColor" ToolTip="黄色" />
                        <Button Width="24" Height="24" Margin="2" Padding="0" Background="#FF42D392" BorderThickness="0" Tag="#42D392" Click="OnPresetColor" ToolTip="绿色" />
                        <Button Width="24" Height="24" Margin="2" Padding="0" Background="#FF35C9D0" BorderThickness="0" Tag="#35C9D0" Click="OnPresetColor" ToolTip="青色" />
                        <Button Width="24" Height="24" Margin="2" Padding="0" Background="#FF4D8DFF" BorderThickness="0" Tag="#4D8DFF" Click="OnPresetColor" ToolTip="蓝色" />
                        <Button Width="24" Height="24" Margin="2" Padding="0" Background="#FFA66BFF" BorderThickness="0" Tag="#A66BFF" Click="OnPresetColor" ToolTip="紫色" />
                        <Button Width="24" Height="24" Margin="2" Padding="0" Background="#FFFFFFFF" BorderBrush="#667080" Tag="#FFFFFF" Click="OnPresetColor" ToolTip="白色" />
                        <Button Style="{StaticResource MiniButton}" Margin="6,0,10,0" Content="色盘" Click="OnOpenColorPalette" />
                        <TextBox x:Name="PenColorInput" Width="1" Height="1" Visibility="Collapsed" TextChanged="OnPenColorChanged" />
                        <TextBlock x:Name="PenWidthLabel" Text="粗细" Foreground="#B7C0D1" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider x:Name="PenWidthInput" Width="110" Minimum="1" Maximum="24" Value="3" ValueChanged="OnPenWidthChanged" />
                        <TextBlock x:Name="TextSizeLabel" Text="字号" Foreground="#B7C0D1" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" />
                        <Slider x:Name="TextSizeInput" Width="110" Minimum="8" Maximum="72" Value="22" Visibility="Collapsed" ValueChanged="OnTextSizeChanged" />
                    </StackPanel>
                    <StackPanel x:Name="MosaicProperties" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="圆形笔刷" Foreground="#DDE3EE" VerticalAlignment="Center" />
                        <Slider x:Name="MosaicBrushInput" Width="118" Margin="8,0" Minimum="6" Maximum="96" Value="28" ValueChanged="OnMosaicBrushChanged" />
                        <TextBlock x:Name="MosaicBrushValue" Width="28" Foreground="#8FA8FF" VerticalAlignment="Center" />
                        <TextBlock Text="像素块" Foreground="#DDE3EE" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <Slider x:Name="MosaicBlockInput" Width="96" Margin="8,0" Minimum="2" Maximum="32" Value="12" ValueChanged="OnMosaicBlockChanged" />
                        <TextBlock x:Name="MosaicBlockValue" Width="28" Foreground="#8FA8FF" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="LongCaptureProperties" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource MiniButton}" Content="手动滚动" Click="OnManualLongCapture" />
                        <Button Style="{StaticResource MiniButton}" Margin="7,0,0,0" Content="自动滚动" Click="OnAutomaticLongCapture" />
                        <Button x:Name="StopLongCaptureButton" Style="{StaticResource MiniButton}" Margin="7,0,0,0"
                                Content="停止并生成" Visibility="Collapsed" Click="OnStopLongCapture" />
                    </StackPanel>
                    <StackPanel x:Name="SizeProperties" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="宽 (px)" Foreground="#DDE3EE" VerticalAlignment="Center" />
                        <TextBox x:Name="SelectionWidthInput" Width="72" Margin="7,0,12,0" Padding="7,4" />
                        <TextBlock Text="高 (px)" Foreground="#DDE3EE" VerticalAlignment="Center" />
                        <TextBox x:Name="SelectionHeightInput" Width="72" Margin="7,0,10,0" Padding="7,4" />
                        <Button Style="{StaticResource MiniButton}" Content="应用尺寸" Click="OnApplySelectionSize" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="PickerHud" Padding="9,7" Background="#F0181D27" BorderBrush="#5A667A" BorderThickness="1"
                    CornerRadius="8" IsHitTestVisible="False" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="PickerHudSwatch" Width="24" Height="24" CornerRadius="5" BorderBrush="#88FFFFFF" BorderThickness="1" />
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock x:Name="PickerHudHex" Foreground="#F5F7FB" FontWeight="SemiBold" />
                        <TextBlock x:Name="PickerHudRgb" Foreground="#AAB4C6" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel x:Name="ToolFeedbackPanel" Orientation="Horizontal">
                <Border x:Name="ToolStatus" Padding="12,7" Background="#F0181D27" BorderBrush="#465166"
                        BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                    <TextBlock x:Name="ToolStatusText" MaxWidth="520" TextTrimming="CharacterEllipsis"
                               Foreground="#F4F7F8" FontFamily="{StaticResource AppFont}" />
                </Border>
                <Button x:Name="TranslationToggle" Style="{StaticResource MiniButton}" Margin="6,0,0,0"
                        Padding="12,5" Content="显示原文" Visibility="Collapsed" Click="OnTranslationToggle" />
            </StackPanel>
        </Canvas>

        <Border x:Name="TextExtractionPanel" MinWidth="300" MinHeight="168"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#F0121620" BorderBrush="#4A566B" BorderThickness="1" CornerRadius="12"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Margin="18,16,14,12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="文字提取" FontSize="17" FontWeight="SemiBold" Foreground="#F5F7FB" />
                        <TextBlock x:Name="ExtractionStatusText" Text="PP-OCR 主路径 · Windows OCR 回退" Margin="0,3,0,0" Foreground="#8F99AD" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ToolButton}" Width="36" Height="36" ToolTip="收起" Click="OnCloseTextExtraction">
                        <Viewbox Width="17" Height="17"><Path Stroke="#C9D0DE" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,3 L14,14 M14,3 L3,14" /></Viewbox>
                    </Button>
                </Grid>
                <TextBox x:Name="ExtractedTextBox" Grid.Row="1" Margin="18,0,18,12" MinHeight="44"
                         IsReadOnly="True" AcceptsReturn="True" VerticalContentAlignment="Top"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0C1017" Foreground="#F2F4F8"
                         BorderBrush="#30394A" BorderThickness="1" Padding="12" FontSize="16" />
                <Grid Grid.Row="2" Margin="18,0,18,16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="按视觉行保留换行" Foreground="#7F899D" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource MiniButton}" Content="一键复制" Click="OnCopyExtractedText" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="EscapeHint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0"
                Padding="14,8" Background="#F0181D27" BorderBrush="#465166" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
            <TextBlock Text="再按一次 Esc 退出" Foreground="#F4F7F8" FontFamily="{StaticResource AppFont}" />
        </Border>
    </Grid>
</Window>
