<Window x:Class="ClipRay.App.Translation.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:ClipRay.App.Settings"
        Title="ClipRay 翻译" Width="940" Height="720" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}"
        FontFamily="{DynamicResource UtilityFont}" FontSize="14"
        Icon="/ClipRay.App;component/Assets/ClipRay-icon-transparent.png">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml"/>
            <ResourceDictionary Source="/ClipRay.App;component/Presentation/UtilityWindowResources.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="TranslateAction" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Padding" Value="16,7"/>
        </Style>
    </ResourceDictionary></Window.Resources>
    <Grid x:Name="TranslationRoot" Background="{DynamicResource WindowBackground}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Image Width="38" Height="38" Margin="0,0,12,0" Source="/ClipRay.App;component/Assets/ClipRay-icon-transparent.png" />
                <StackPanel Grid.Column="1"><TextBlock settings:SettingsText.Chinese="翻译" settings:SettingsText.English="Translation" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock settings:SettingsText.Chinese="本地隐私翻译或临时切换 DeepSeek；不会修改默认设置" settings:SettingsText.English="Translate locally or use DeepSeek for this session. Your defaults stay unchanged." Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
            </Grid>
            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="50,8,0,0" HorizontalAlignment="Left" Padding="10,6" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <TextBlock x:Name="ProviderStatus" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="13" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock settings:SettingsText.Chinese="源语言" settings:SettingsText.English="Source language" Margin="0,0,0,7" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="SourceLanguageBox" SelectedIndex="0">
                    <ComboBoxItem Tag="auto" settings:SettingsText.Chinese="自动检测" settings:SettingsText.English="Auto detect" />
                    <ComboBoxItem Tag="English" Content="English" />
                    <ComboBoxItem Tag="简体中文" settings:SettingsText.Chinese="简体中文" settings:SettingsText.English="Simplified Chinese" />
                    <ComboBoxItem Tag="Japanese" settings:SettingsText.Chinese="日语" settings:SettingsText.English="Japanese" />
                    <ComboBoxItem Tag="Korean" settings:SettingsText.Chinese="韩语" settings:SettingsText.English="Korean" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock settings:SettingsText.Chinese="目标语言" settings:SettingsText.English="Target language" Margin="0,0,0,7" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="TargetLanguageBox" SelectedIndex="0">
                    <ComboBoxItem Tag="简体中文" settings:SettingsText.Chinese="简体中文" settings:SettingsText.English="Simplified Chinese" />
                    <ComboBoxItem Tag="English" Content="English" />
                    <ComboBoxItem Tag="Japanese" settings:SettingsText.Chinese="日语" settings:SettingsText.English="Japanese" />
                    <ComboBoxItem Tag="Korean" settings:SettingsText.Chinese="韩语" settings:SettingsText.English="Korean" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock settings:SettingsText.Chinese="本次模型" settings:SettingsText.English="Model for this session" Margin="0,0,0,7" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="RouteBox" SelectionChanged="OnRouteChanged" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="Transparent" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock settings:SettingsText.Chinese="原文" settings:SettingsText.English="Source text" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9" />
                <TextBox x:Name="InputText" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" />
            </Grid>
        </Border>
        <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" />
        <Border Grid.Row="4" Background="Transparent" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock settings:SettingsText.Chinese="译文" settings:SettingsText.English="Translation" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9" />
                <TextBox x:Name="ResultText" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Padding="12" />
            </Grid>
        </Border>
        <Grid Grid.Row="5" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="ProgressStatus" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,16,0" VerticalAlignment="Center" settings:SettingsText.Chinese="就绪" settings:SettingsText.English="Ready" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="LiveTranslateButton" settings:SettingsText.Chinese="实时区域翻译" settings:SettingsText.English="Live region translation" MinWidth="122" Margin="0,0,8,0" Click="OnLiveTranslate" />
                <Button x:Name="CopyButton" settings:SettingsText.Chinese="复制译文" settings:SettingsText.English="Copy translation" MinWidth="110" Click="OnCopy" />
                <Button x:Name="TranslateButton" settings:SettingsText.Chinese="开始翻译" settings:SettingsText.English="Translate" MinWidth="122" Margin="10,0,0,0" Click="OnTranslate"
                        Style="{StaticResource TranslateAction}" FontWeight="SemiBold" RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform><ScaleTransform x:Name="TranslateButtonScale" ScaleX="1" ScaleY="1" /></Button.RenderTransform>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
