<Window x:Class="ClipRay.App.LiveTranslation.LiveTranslationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" Focusable="False" IsHitTestVisible="False">
    <Grid>
        <Canvas x:Name="TranslationCanvas" Background="Transparent" />
        <Border x:Name="SelectionBorder" BorderBrush="#66D9FF" BorderThickness="2" CornerRadius="2" />
    </Grid>
</Window>
