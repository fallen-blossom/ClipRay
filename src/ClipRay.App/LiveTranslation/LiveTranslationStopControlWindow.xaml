<Window x:Class="ClipRay.App.LiveTranslation.LiveTranslationStopControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="260" Height="112" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" SizeToContent="Manual">
    <Border Background="#F5171D27" BorderBrush="#586A83" BorderThickness="1" CornerRadius="10" Padding="12,10">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="StopButton" Content="停止翻译" Click="OnStop" Foreground="White" Background="#33445C"
                        BorderThickness="0" Padding="10,5" FontSize="12" Cursor="Hand" ToolTip="双击 Esc 也可停止" />
                <TextBlock x:Name="EscapeHint" Grid.Column="1" Text="双击 Esc 退出" Foreground="#BBC5D4" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0" />
                <Button x:Name="RetryButton" Grid.Column="2" Content="重试" Click="OnRetry" Visibility="Collapsed"
                        Margin="8,0,0,0" Padding="8,4" Foreground="White" Background="#33445C" BorderThickness="0" />
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="2" Text="正在启动本地机翻…" Foreground="#D5DCE7" FontSize="12" AutomationProperties.LiveSetting="Polite"
                       LineHeight="17" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</Window>
