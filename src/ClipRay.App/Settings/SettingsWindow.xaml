<Window x:Class="ClipRay.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:ClipRay.App.Settings"
        Title="ClipRay 设置" Width="940" Height="760" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#0E1118" Foreground="#F4F6FB"
        FontFamily="Segoe UI, Microsoft YaHei UI" Icon="/ClipRay.App;component/Assets/ClipRay-icon-transparent.png"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#171B24" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#293142" />
        <SolidColorBrush x:Key="InputBrush" Color="#10141C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6E8BFF" />
        <LinearGradientBrush x:Key="SignatureRainbow" StartPoint="0,0" EndPoint="1,1" Opacity="0.38">
            <GradientStop Color="#BC334B79" Offset="0" /><GradientStop Color="#B9447967" Offset="0.25" />
            <GradientStop Color="#B9816D3F" Offset="0.5" /><GradientStop Color="#B97B3F68" Offset="0.75" />
            <GradientStop Color="#B9483F80" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RainbowBorder" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF4D6D" Offset="0" /><GradientStop Color="#FFB347" Offset="0.2" />
            <GradientStop Color="#FFE66D" Offset="0.4" /><GradientStop Color="#45D6A0" Offset="0.6" />
            <GradientStop Color="#4D8DFF" Offset="0.8" /><GradientStop Color="#B26DFF" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" /></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Background="#536078" MinHeight="30"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="2,0" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" /></Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E9ECF4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F4F6FB" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="#343D50" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CaretBrush" Value="#F4F6FB" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#F4F6FB" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="#343D50" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F6FB" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="#343D50" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="10,0,4,0"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="#F4F6FB" />
                                                <Path Grid.Column="1" Width="9" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4.5 5 L 9 0" Stroke="#9CA8BD" StrokeThickness="1.5" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0" Padding="4" Background="#171D28" BorderBrush="#343D50"
                                        BorderThickness="1" CornerRadius="7">
                                    <ScrollViewer MaxHeight="260"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F4F6FB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#263149" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#233963" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D9DEEA" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EDF1FA" />
            <Setter Property="Background" Value="#222938" />
            <Setter Property="BorderBrush" Value="#374157" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2B3548" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#35415A" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B5C3FF" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#89A0FF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RefreshButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#176678" />
            <Setter Property="BorderBrush" Value="#3CB4CB" />
            <Setter Property="Foreground" Value="#ECFCFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F7F8FC" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1D2431" /><Setter Property="Foreground" Value="#C8D0DF" />
            <Setter Property="BorderBrush" Value="#30394A" /><Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,8" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#E8ECF5" />
            <Setter Property="BorderBrush" Value="#252D3B" /><Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#111722" /><Setter Property="Foreground" Value="#E8ECF5" />
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#253653" /></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="26,22,26,16">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SettingsHeading" Text="ClipRay 设置" FontSize="28" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                    <Image Width="57" Height="57" Margin="18,6,0,-6" VerticalAlignment="Center"
                           Source="/ClipRay.App;component/Assets/ClipRay-icon-transparent.png" Stretch="Uniform"
                           ToolTip="ClipRay" />
                </StackPanel>
                <StackPanel Margin="0,5,16,0">
                    <TextBlock x:Name="SettingsSubtitle" Text="截图、快捷键、翻译与本地模型" Foreground="#919AAF" TextWrapping="Wrap" />
                    <TextBlock x:Name="VersionText"
                               Margin="0,4,0,0" Foreground="#71809A" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="界面语言 / Interface language" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="InterfaceLanguageBox" Width="165" AutomationProperties.Name="Interface language"
                              ToolTip="跟随 Windows 显示语言，或保存手动选择 / Follow Windows display language or save a manual choice">
                        <ComboBoxItem Content="跟随 Windows / Auto" Tag="auto"/>
                        <ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="TutorialButton" Content="查看使用教程 ↗" Click="OpenTutorial_Click"
                    Margin="0,0,28,0" Padding="14,8" FontSize="13" FontWeight="SemiBold"
                    Foreground="White" Background="#4FA9DC" BorderBrush="#A8DDF5"
                    ToolTip="打开随 ClipRay 安装的离线使用教程" />
            <Border x:Name="SignatureBadge" Padding="22.4,11.2" CornerRadius="20.8"
                    Background="#171C27" BorderThickness="1.6" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5" MouseEnter="OnSignatureMouseEnter" MouseLeave="OnSignatureMouseLeave">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" Opacity="0.82">
                        <GradientStop Color="#FF4D6D" Offset="0" /><GradientStop Color="#FFB347" Offset="0.2" />
                        <GradientStop Color="#FFE66D" Offset="0.4" /><GradientStop Color="#45D6A0" Offset="0.6" />
                        <GradientStop Color="#4D8DFF" Offset="0.8" /><GradientStop Color="#B26DFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                <TextBlock Text="by Fallen-Flower ❀O.o？" Foreground="#F2F4FA" FontWeight="SemiBold" FontSize="19.2" />
            </Border>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="26,0,26,10">
                <Button x:Name="OutputNavigation" Content="输出与维护" Tag="OutputSection" Click="SectionNavigation_Click" />
                <Button x:Name="StartupNavigation" Content="启动" Tag="StartupSection" Click="SectionNavigation_Click" Margin="8,0,0,0" />
                <Button x:Name="HotkeysNavigation" settings:SettingsText.Chinese="快捷键" settings:SettingsText.English="Shortcuts" Tag="HotkeysSection" Click="SectionNavigation_Click" Margin="8,0,0,0" />
                <Button x:Name="TranslationNavigation" Content="翻译" Tag="TranslationSection" Click="SectionNavigation_Click" Margin="8,0,0,0" />
            </StackPanel>
        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Padding="26,0,26,10">
            <StackPanel>
                <Border x:Name="OutputSection" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" settings:SettingsText.Chinese="保存位置与反馈" settings:SettingsText.English="Save locations and feedback" />
                        <TextBlock settings:SettingsText.Chinese="截图" settings:SettingsText.English="Screenshots" Foreground="#C9D1E2" Margin="0,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ScreenshotDirectoryBox" MinWidth="250" />
                            <Button x:Name="ChooseScreenshotFolderButton" Grid.Column="1" Margin="10,0,0,0" settings:SettingsText.Chinese="选择目录" settings:SettingsText.English="Browse" Click="ChooseScreenshotFolder_Click" />
                            <Button x:Name="OpenScreenshotFolderButton" Grid.Column="2" Margin="8,0,0,0" settings:SettingsText.Chinese="打开" settings:SettingsText.English="Open" Click="OpenScreenshotFolder_Click" />
                        </Grid>
                        <TextBlock settings:SettingsText.Chinese="长截图" settings:SettingsText.English="Scrolling captures" Foreground="#C9D1E2" Margin="0,12,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="LongCaptureDirectoryBox" MinWidth="250" />
                            <Button x:Name="ChooseLongCaptureFolderButton" Grid.Column="1" Margin="10,0,0,0" settings:SettingsText.Chinese="选择目录" settings:SettingsText.English="Browse" Click="ChooseLongCaptureFolder_Click" />
                            <Button x:Name="OpenLongCaptureFolderButton" Grid.Column="2" Margin="8,0,0,0" settings:SettingsText.Chinese="打开" settings:SettingsText.English="Open" Click="OpenLongCaptureFolder_Click" />
                        </Grid>
                        <TextBlock settings:SettingsText.Chinese="录屏" settings:SettingsText.English="Recordings" Foreground="#C9D1E2" Margin="0,12,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="RecordingDirectoryBox" MinWidth="250" />
                            <Button x:Name="ChooseRecordingFolderButton" Grid.Column="1" Margin="10,0,0,0" settings:SettingsText.Chinese="选择目录" settings:SettingsText.English="Browse" Click="ChooseRecordingFolder_Click" />
                            <Button x:Name="OpenRecordingFolderButton" Grid.Column="2" Margin="8,0,0,0" settings:SettingsText.Chinese="打开" settings:SettingsText.English="Open" Click="OpenRecordingFolder_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <CheckBox x:Name="CopyToClipboardBox" settings:SettingsText.Chinese="完成后自动复制到剪贴板" settings:SettingsText.English="Automatically copy to clipboard when finished" Margin="0,0,28,0" />
                            <CheckBox x:Name="BorderFeedbackBox" settings:SettingsText.Chinese="显示屏幕边框反馈" settings:SettingsText.English="Show screen border feedback" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Foreground="#AEB8CD" TextWrapping="Wrap"
                                   settings:SettingsText.Chinese="默认开启：截图和长截图复制图片，录屏复制视频文件。关闭后仍保存文件，可从最近截取手动复制。Win+V 历史只支持不超过 4 MB 的图片等内容，不显示视频文件。"
                                   settings:SettingsText.English="Enabled by default: screenshots copy images; recordings copy video files. When disabled, files are still saved and can be copied from Recent captures. Win+V history supports images up to 4 MB; video files are not displayed." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" settings:SettingsText.Chinese="自动清理" settings:SettingsText.English="Automatic cleanup" />
                        <CheckBox x:Name="CleanupScheduleBox" settings:SettingsText.Chinese="启用 Windows 自动清理（当前用户）" settings:SettingsText.English="Enable scheduled cleanup in Windows (current user)" />
                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal"
                                    IsEnabled="{Binding IsChecked, ElementName=CleanupScheduleBox}">
                            <TextBlock settings:SettingsText.Chinese="文件保留" settings:SettingsText.English="Keep files for" VerticalAlignment="Center" />
                            <TextBox x:Name="CleanupRetentionDaysBox" Width="62" Margin="8,0,5,0"
                                     HorizontalContentAlignment="Center" />
                            <TextBlock settings:SettingsText.Chinese="天，" settings:SettingsText.English="days," VerticalAlignment="Center" />
                            <ComboBox x:Name="CleanupFrequencyBox" Width="82" Margin="8,0,0,0"
                                      SelectionChanged="CleanupFrequencyBox_SelectionChanged">
                                <ComboBoxItem Tag="每天" settings:SettingsText.Chinese="每天" settings:SettingsText.English="Daily" /><ComboBoxItem Tag="每周" settings:SettingsText.Chinese="每周" settings:SettingsText.English="Weekly" />
                            </ComboBox>
                            <ComboBox x:Name="CleanupWeeklyDayBox" Width="82" Margin="7,0,0,0">
                                <ComboBoxItem Tag="周一" settings:SettingsText.Chinese="周一" settings:SettingsText.English="Mon" /><ComboBoxItem Tag="周二" settings:SettingsText.Chinese="周二" settings:SettingsText.English="Tue" /><ComboBoxItem Tag="周三" settings:SettingsText.Chinese="周三" settings:SettingsText.English="Wed" />
                                <ComboBoxItem Tag="周四" settings:SettingsText.Chinese="周四" settings:SettingsText.English="Thu" /><ComboBoxItem Tag="周五" settings:SettingsText.Chinese="周五" settings:SettingsText.English="Fri" /><ComboBoxItem Tag="周六" settings:SettingsText.Chinese="周六" settings:SettingsText.English="Sat" />
                                <ComboBoxItem Tag="周日" settings:SettingsText.Chinese="周日" settings:SettingsText.English="Sun" />
                            </ComboBox>
                            <TextBlock settings:SettingsText.Chinese="执行时间" settings:SettingsText.English="Run at" Margin="9,0,0,0" VerticalAlignment="Center" />
                            <TextBox x:Name="CleanupDailyTimeBox" Width="82" Margin="7,0,0,0"
                                     HorizontalContentAlignment="Center"
                                     PreviewTextInput="CleanupDailyTimeBox_PreviewTextInput"
                                     PreviewKeyDown="CleanupDailyTimeBox_PreviewKeyDown"
                                     LostFocus="CleanupDailyTimeBox_LostFocus" />
                        </StackPanel>
                        <TextBlock Margin="0,11,0,0" Foreground="#8E98AC" TextWrapping="Wrap"
                                   settings:SettingsText.Chinese="将超过保留天数且有保存完成证明的 ClipRay 截图、长截图和录屏移入回收站；旧文件、未完成录屏、恢复数据和其他文件保留。回收失败会记录并保留原文件。" settings:SettingsText.English="Moves expired ClipRay screenshots, scrolling captures and recordings with saved completion records to the Recycle Bin. Historical files without records, incomplete recordings, recovery data and other files are kept. Recycling failures are recorded and keep the original file." />
                        <TextBlock Margin="0,9,0,0" Foreground="#C9D1E2">
                            <Run settings:SettingsText.Chinese="计划状态：" settings:SettingsText.English="Schedule: " /><Run x:Name="CleanupScheduleStateText" Text="未启用" />
                        </TextBlock>
                        <TextBlock Margin="0,5,0,0" Foreground="#C9D1E2">
                            <Run settings:SettingsText.Chinese="上次执行：" settings:SettingsText.English="Last run: " /><Run x:Name="CleanupLastRunText" Text="从未执行" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border x:Name="StartupSection" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" settings:SettingsText.Chinese="启动与计划" settings:SettingsText.English="Startup" />
                        <CheckBox x:Name="StartupBox" settings:SettingsText.Chinese="登录 Windows 后启动 ClipRay（当前用户）" settings:SettingsText.English="Start ClipRay when signing in to Windows (current user)" />
                        <TextBlock Margin="0,9,0,0" Foreground="#C9D1E2">
                            <Run settings:SettingsText.Chinese="启动状态：" settings:SettingsText.English="Startup status: " /><Run x:Name="StartupStateText" Text="正在读取…" />
                        </TextBlock>
                        <TextBlock Margin="0,9,0,0" Foreground="#8E98AC" TextWrapping="Wrap"
                                   settings:SettingsText.Chinese="开机自启仅作用于当前 Windows 用户；安装器中的启动选项和这里的设置使用同一用途。" settings:SettingsText.English="Startup applies to the current Windows user. This setting and the installer startup option control the same registration." />
                    </StackPanel>
                </Border>

                <Border x:Name="HotkeysSection" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" settings:SettingsText.Chinese="快捷键" settings:SettingsText.English="Shortcuts" />
                        <TextBlock settings:SettingsText.Chinese="点击输入框后直接按组合键。主快捷键按 Backspace 恢复默认；备用快捷键按 Backspace 或 Delete 清空。部分全屏游戏会占用单键，建议使用组合键。" settings:SettingsText.English="Select a field and press a key combination. Backspace resets a primary shortcut; Backspace or Delete clears an alternate shortcut. Use combinations when full-screen games intercept single keys." Foreground="#8E98AC" Margin="0,-8,0,10" TextWrapping="Wrap" />
                        <TextBlock settings:SettingsText.Chinese="区域截图默认吸附外层窗口；按住 Ctrl 可临时吸附窗口内控件。" settings:SettingsText.English="Region capture snaps to windows by default. Hold Ctrl to snap to controls inside a window." Foreground="#8E98AC" Margin="0,-4,0,10" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" settings:SettingsText.Chinese="主快捷键" settings:SettingsText.English="Primary shortcut" Foreground="#AEB8CB" FontWeight="SemiBold" Margin="8,0,10,5" />
                            <TextBlock Grid.Row="10" settings:SettingsText.Chinese="开始实时翻译" settings:SettingsText.English="Start live translation" VerticalAlignment="Center" />
                            <TextBox x:Name="StartLiveTranslationHotkeyBox" Grid.Row="10" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="StartLiveTranslationSecondaryHotkeyBox" Grid.Row="10" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="11" settings:SettingsText.Chinese="停止实时翻译" settings:SettingsText.English="Stop live translation" VerticalAlignment="Center" />
                            <TextBox x:Name="StopLiveTranslationHotkeyBox" Grid.Row="11" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="StopLiveTranslationSecondaryHotkeyBox" Grid.Row="11" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Column="2" settings:SettingsText.Chinese="备用快捷键（可选）" settings:SettingsText.English="Alternate shortcut (optional)" Foreground="#AEB8CB" FontWeight="SemiBold" Margin="8,0,0,5" />

                            <TextBlock Grid.Row="1" settings:SettingsText.Chinese="区域截图" settings:SettingsText.English="Capture region" VerticalAlignment="Center" />
                            <TextBox x:Name="RegionHotkeyBox" Grid.Row="1" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="RegionSecondaryHotkeyBox" Grid.Row="1" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="2" settings:SettingsText.Chinese="全屏截图（不含任务栏）" settings:SettingsText.English="Capture screen (without taskbar)" VerticalAlignment="Center" />
                            <TextBox x:Name="CurrentHotkeyBox" Grid.Row="2" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="CurrentSecondaryHotkeyBox" Grid.Row="2" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="3" settings:SettingsText.Chinese="全屏截图（含任务栏）" settings:SettingsText.English="Capture screen (with taskbar)" VerticalAlignment="Center" />
                            <TextBox x:Name="TaskbarFreeCurrentHotkeyBox" Grid.Row="3" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="TaskbarFreeCurrentSecondaryHotkeyBox" Grid.Row="3" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="4" settings:SettingsText.Chinese="完整虚拟桌面" settings:SettingsText.English="Capture all screens" VerticalAlignment="Center" />
                            <TextBox x:Name="DesktopHotkeyBox" Grid.Row="4" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="DesktopSecondaryHotkeyBox" Grid.Row="4" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="5" settings:SettingsText.Chinese="开始录屏" settings:SettingsText.English="Start recording" VerticalAlignment="Center" />
                            <TextBox x:Name="StartRecordingHotkeyBox" Grid.Row="5" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="StartRecordingSecondaryHotkeyBox" Grid.Row="5" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="6" settings:SettingsText.Chinese="停止录屏" settings:SettingsText.English="Stop recording" VerticalAlignment="Center" />
                            <TextBox x:Name="StopRecordingHotkeyBox" Grid.Row="6" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="StopRecordingSecondaryHotkeyBox" Grid.Row="6" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="7" settings:SettingsText.Chinese="确认截图" settings:SettingsText.English="Confirm capture" VerticalAlignment="Center" />
                            <TextBox x:Name="ConfirmCaptureHotkeyBox" Grid.Row="7" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="ConfirmCaptureSecondaryHotkeyBox" Grid.Row="7" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="8" settings:SettingsText.Chinese="双按退出键取消" settings:SettingsText.English="Press exit key twice to cancel" VerticalAlignment="Center" />
                            <TextBox x:Name="CancelCaptureHotkeyBox" Grid.Row="8" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="CancelCaptureSecondaryHotkeyBox" Grid.Row="8" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="9" settings:SettingsText.Chinese="停止长截图" settings:SettingsText.English="Stop scrolling capture" VerticalAlignment="Center" />
                            <TextBox x:Name="StopLongCaptureHotkeyBox" Grid.Row="9" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="StopLongCaptureSecondaryHotkeyBox" Grid.Row="9" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                        </Grid>
                        <TextBlock Margin="0,10,0,0" Foreground="#AEB8CB"
                                   settings:SettingsText.Chinese="编辑快捷键：Ctrl+Z 撤回 · Ctrl+Shift+Z 重做" settings:SettingsText.English="Editing: Ctrl+Z to undo · Ctrl+Shift+Z to redo" />
                    </StackPanel>
                </Border>

                <Border x:Name="TranslationSection" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" settings:SettingsText.Chinese="翻译方式与模型" settings:SettingsText.English="Translation providers and models" />
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock settings:SettingsText.Chinese="区域翻译" settings:SettingsText.English="Region translation" VerticalAlignment="Center" Foreground="#C9D1E2" />
                            <ComboBox x:Name="ProviderBox" Grid.Column="1" SelectionChanged="ProviderBox_SelectionChanged">
                                <ComboBoxItem Content="Machine" Tag="Machine" />
                                <ComboBoxItem Content="DeepSeek" />
                            </ComboBox>
                            <ComboBox x:Name="ModelBox" Grid.Column="2" Margin="10,0,0,0" SelectionChanged="ProviderBox_SelectionChanged">
                                <ComboBoxItem Content="DeepSeek V4.1 Flash" Tag="deepseek-flash" />
                            </ComboBox>
                            <Button x:Name="TestProviderButton" Grid.Column="3" HorizontalAlignment="Right" Margin="10,0,0,0"
                                     Content="验证连接" Click="TestConnection_Click" />
                            <TextBlock Grid.Row="1" settings:SettingsText.Chinese="实时翻译" settings:SettingsText.English="Live translation" Margin="0,10,0,0" VerticalAlignment="Center" Foreground="#C9D1E2" />
                            <ComboBox x:Name="LiveProviderBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                                      SelectionChanged="ProviderBox_SelectionChanged">
                                <ComboBoxItem settings:SettingsText.Chinese="Machine（默认，速度优先）" settings:SettingsText.English="Machine (default, fast)" Tag="Machine" />
                                <ComboBoxItem Content="DeepSeek V4.1 Flash" Tag="DeepSeek" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="12,10,0,0"
                                       settings:SettingsText.Chinese="实时翻译不使用本地大模型；Machine 响应最快。" settings:SettingsText.English="Live translation does not use local language models. Machine prioritizes speed." VerticalAlignment="Center"
                                       Foreground="#8E98AC" TextWrapping="Wrap" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock settings:SettingsText.Chinese="截图翻译目标语言" settings:SettingsText.English="Capture target language" VerticalAlignment="Center" Foreground="#C9D1E2" />
                            <ComboBox x:Name="TranslationTargetLanguageBox" Width="160" Margin="12,0,0,0">
                                <ComboBoxItem Tag="简体中文" settings:SettingsText.Chinese="简体中文" settings:SettingsText.English="Simplified Chinese" />
                                <ComboBoxItem Tag="English" Content="English" /><ComboBoxItem Tag="日本語" Content="日本語" />
                                <ComboBoxItem Tag="Français" Content="Français" /><ComboBoxItem Tag="Русский" Content="Русский" />
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="LiveStopControlBox" Margin="0,12,0,0" settings:SettingsText.Chinese="显示实时翻译停止控件" settings:SettingsText.English="Show the stop control for live translation" />
                        <CheckBox x:Name="LiveRecordingOverlayBox" Margin="0,8,0,0" settings:SettingsText.Chinese="在录屏中显示实时译文" settings:SettingsText.English="Include live translations in recordings" />
                        <TextBlock settings:SettingsText.Chinese="默认不会把实时译文录进视频。开启后，实时译文会出现在录屏中。以上选项下次启动实时翻译时生效。隐藏停止控件后，仍可双按 Esc 或使用停止快捷键退出。" settings:SettingsText.English="Live translations are excluded from recordings by default. Enable this option to include them. These settings apply the next time live translation starts. With the stop control hidden, press Esc twice or use the stop shortcut to exit." Foreground="#8E98AC" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <CheckBox x:Name="MachineFallbackBox" Margin="0,12,0,0"
                                  settings:SettingsText.Chinese="主翻译失败时使用本地机翻兜底（仅 English → 简体中文）" settings:SettingsText.English="Use local machine translation if the primary provider fails (English → Simplified Chinese only)" />
                        <TextBlock settings:SettingsText.Chinese="Insert 默认不含任务栏；Ctrl+Insert 包含任务栏；自由截图可框选全部屏幕。实时翻译默认使用本地机翻（English → 简体中文），也可在上方改用 DeepSeek。" settings:SettingsText.English="Insert excludes the taskbar; Ctrl+Insert includes it. Region capture can span all screens. Live translation defaults to local machine translation (English → Simplified Chinese); you can select DeepSeek above." Foreground="#8E98AC" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <Border x:Name="DeepSeekCostPanel" Margin="0,12,0,0" Padding="14,11" CornerRadius="9"
                                Background="#111722" BorderBrush="#293750" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock settings:SettingsText.Chinese="DeepSeek 本机费用统计" settings:SettingsText.English="DeepSeek usage costs on this device" FontWeight="SemiBold" Foreground="#DDE5FF" />
                                    <TextBlock x:Name="DeepSeekCostSummaryDetailText" Margin="0,4,0,0" Foreground="#8490A8" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="DeepSeekCostSummaryText" Text="累计预估费用：加载中…"
                                               VerticalAlignment="Center" Foreground="#D9C5FF" FontWeight="SemiBold" />
                                    <Button x:Name="ClearDeepSeekCostButton" Margin="12,0,0,0" Padding="12,6"
                                            settings:SettingsText.Chinese="清除统计" settings:SettingsText.English="Reset statistics" Click="ResetDeepSeekCost_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="LocalModelPanel" Margin="0,12,0,0" Padding="14" CornerRadius="9" Background="#111722" BorderBrush="#293750" BorderThickness="1">
                            <StackPanel x:Name="LocalModelContentPanel">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="LocalModelNameText" Text="LMT-60-0.6B · Q4_K_M" FontWeight="SemiBold" Foreground="#DDE5FF" />
                                        <TextBlock x:Name="LocalModelStatusText" Text="离线短进程，不开放端口" Margin="0,3,0,0" Foreground="#8490A8" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="9,4" Background="#153528" CornerRadius="10" VerticalAlignment="Center">
                                        <TextBlock Text="LOCAL" Foreground="#67D8A2" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                                <TextBlock settings:SettingsText.Chinese="本地模型文件（GGUF）" settings:SettingsText.English="Local model file (GGUF)" Margin="0,12,0,5" Foreground="#C9D1E2" />
                                <TextBox x:Name="LocalLmtModelPathBox" IsReadOnly="True" ToolTip="当前选择的 LMT Q4_K_M GGUF 文件" />
                                <TextBlock settings:SettingsText.Chinese="试译文本" settings:SettingsText.English="Test input" Margin="0,12,0,5" Foreground="#C9D1E2" />
                                <TextBox x:Name="LocalTrialInputBox" Text="The weather is pleasant today." />
                                <TextBlock settings:SettingsText.Chinese="试译结果" settings:SettingsText.English="Test result" Margin="0,12,0,5" Foreground="#C9D1E2" />
                                <TextBox x:Name="LocalTrialResultBox" MinHeight="42" IsReadOnly="True" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="CredentialCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" settings:SettingsText.Chinese="API 凭据" settings:SettingsText.English="API credentials" />
                        <TextBlock x:Name="CredentialDescriptionText" settings:SettingsText.Chinese="使用当前选择的本机凭据，兼容旧凭据名称；新配置使用固定槽。密钥保存在 Windows Credential Manager，设置文件不保存明文。" settings:SettingsText.English="Uses the currently selected local credential, including legacy credential names; new configurations use the fixed slot. The key is stored in Windows Credential Manager, not in plain text settings."
                                   Foreground="#8E98AC" Margin="0,-8,0,12" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="API Key" VerticalAlignment="Center" /><PasswordBox x:Name="CredentialValueBox" Grid.Column="1" Margin="8,4,0,4" />
                        </Grid>
                        <TextBlock x:Name="CredentialSlotStatusText" Foreground="#8E98AC" Margin="128,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="128,10,0,0">
                            <Button x:Name="SaveCredentialButton" settings:SettingsText.Chinese="验证并保存/替换固定凭据" settings:SettingsText.English="Verify and save or replace credential" Click="SaveCredential_Click" />
                            <Button x:Name="DeleteCredentialButton" settings:SettingsText.Chinese="删除" settings:SettingsText.English="Delete" Margin="8,0,0,0" Click="DeleteCredential_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </DockPanel>

        <Border Grid.Row="2" Background="#141821" BorderBrush="#293142" BorderThickness="0,1,0,0" Padding="26,15">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock x:Name="HotkeyRegistrationWarningText" Visibility="Collapsed" Foreground="#FFADB5"
                               Margin="0,0,18,8" MaxWidth="640" HorizontalAlignment="Left" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <Border x:Name="StatusPanel" Grid.Row="1" Padding="12,8" Margin="0,0,18,0" CornerRadius="9"
                            HorizontalAlignment="Left" MaxWidth="640"
                            Background="#171E2B" BorderBrush="#344158" BorderThickness="1"
                            Opacity="0" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleX="0.96" ScaleY="0.96" /></Border.RenderTransform>
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="StatusIcon" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center"
                                  Stretch="Uniform" Stroke="#69DDB0" StrokeThickness="2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Data="M 2,9 L 7,14 L 16,3" />
                            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#DCE5F4" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="UninstallButton" Content="卸载 ClipRay" Visibility="Collapsed"
                            MinWidth="104" Margin="0,0,20,0" Padding="14,8"
                            Background="#25191E" BorderBrush="#8C3F4E" Foreground="#FFADB5"
                            Click="Uninstall_Click" />
                    <Button x:Name="CloseSettingsButton" Content="关闭" MinWidth="88" Click="Close_Click" />
                    <Button x:Name="SaveSettingsButton" Style="{StaticResource RefreshButton}" Content="立即刷新" MinWidth="112"
                            Margin="10,0,0,0" FocusVisualStyle="{x:Null}" Click="Apply_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
