<Window x:Class="ClipRay.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:ClipRay.App.Settings"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="ClipRay 设置" Width="1040" Height="780" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}"
        FontFamily="{DynamicResource UtilityFont}" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" Icon="/ClipRay.App;component/Assets/ClipRay-icon-transparent.png"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml"/>
            <ResourceDictionary Source="/ClipRay.App;component/Presentation/UtilityWindowResources.xaml"/>
        </ResourceDictionary.MergedDictionaries>
<LinearGradientBrush x:Key="SignatureRainbow" StartPoint="0,0" EndPoint="1,1" Opacity="0.38">
            <GradientStop Color="#BC334B79" Offset="0" /><GradientStop Color="#B9447967" Offset="0.25" />
            <GradientStop Color="#B9816D3F" Offset="0.5" /><GradientStop Color="#B97B3F68" Offset="0.75" />
            <GradientStop Color="#B9483F80" Offset="1" />
        </LinearGradientBrush>
<LinearGradientBrush x:Key="RainbowBorder" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF4D6D" Offset="0" /><GradientStop Color="#FFB347" Offset="0.2" />
            <GradientStop Color="#FFE66D" Offset="0.4" /><GradientStop Color="#45D6A0" Offset="0.6" />
            <GradientStop Color="#4D8DFF" Offset="0.8" /><GradientStop Color="#B26DFF" Offset="1" />
        </LinearGradientBrush>
        <!-- Native styles are resolved here, beside their declared Fluent dependency. -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="14,6"/>
        </Style>
        <Style x:Key="RefreshButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
            </DataTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="12,8"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border x:Name="Marker" Grid.ColumnSpan="2" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-11,0,0,0" Background="Transparent"/>
                        <TextBlock x:Name="NavGlyph" Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                </Border><ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavSurface" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="primitives:Selector.IsSelected" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/><Setter TargetName="Marker" Property="Background" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}"/></Trigger>
<Trigger Property="Tag" Value="OutputSection"><Setter TargetName="NavGlyph" Property="Text" Value="&#xE8B7;"/></Trigger>
<Trigger Property="Tag" Value="RecordingSection"><Setter TargetName="NavGlyph" Property="Text" Value="&#xE714;"/></Trigger>
<Trigger Property="Tag" Value="TranslationSection"><Setter TargetName="NavGlyph" Property="Text" Value="&#xE8C1;"/></Trigger>
<Trigger Property="Tag" Value="HotkeysSection"><Setter TargetName="NavGlyph" Property="Text" Value="&#xE765;"/></Trigger>
<Trigger Property="Tag" Value="MaintenanceSection"><Setter TargetName="NavGlyph" Property="Text" Value="&#xE90F;"/></Trigger>
<Trigger Property="Tag" Value="HelpSection"><Setter TargetName="NavGlyph" Property="Text" Value="&#xE897;"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </ResourceDictionary></Window.Resources>
    <Grid x:Name="SettingsRoot" Background="{DynamicResource WindowBackground}"><Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="SettingsNavigationPane" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Padding="8,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <Grid Margin="12,20,12,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Image Source="/ClipRay.App;component/Assets/ClipRay-icon-transparent.png" Width="26" Height="26" Margin="0,0,10,0"/>
                    <TextBlock x:Name="SettingsHeading" Grid.Column="1" Text="ClipRay" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SettingsSubtitle" Visibility="Collapsed"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SettingsNavButtons">
<Button x:Name="StartupNavigation" Style="{StaticResource NavigationButton}" Tag="StartupSection" Click="SectionNavigation_Click" settings:SettingsText.Chinese="常规" settings:SettingsText.English="General"/>
<Button x:Name="OutputNavigation" Style="{StaticResource NavigationButton}" Tag="OutputSection" Click="SectionNavigation_Click" settings:SettingsText.Chinese="保存与复制" settings:SettingsText.English="Save and copy"/>
<Button x:Name="RecordingNavigation" Style="{StaticResource NavigationButton}" Tag="RecordingSection" Click="SectionNavigation_Click" settings:SettingsText.Chinese="录屏" settings:SettingsText.English="Recording"/>
<Button x:Name="TranslationNavigation" Style="{StaticResource NavigationButton}" Tag="TranslationSection" Click="SectionNavigation_Click" settings:SettingsText.Chinese="翻译与模型" settings:SettingsText.English="Translation"/>
<Button x:Name="HotkeysNavigation" Style="{StaticResource NavigationButton}" Tag="HotkeysSection" Click="SectionNavigation_Click" settings:SettingsText.Chinese="快捷键" settings:SettingsText.English="Shortcuts"/>
<Button x:Name="MaintenanceNavigation" Style="{StaticResource NavigationButton}" Tag="MaintenanceSection" Click="SectionNavigation_Click" settings:SettingsText.Chinese="维护与清理" settings:SettingsText.English="Maintenance"/>
<Button x:Name="HelpNavigation" Style="{StaticResource NavigationButton}" Tag="HelpSection" Click="SectionNavigation_Click" settings:SettingsText.Chinese="使用帮助" settings:SettingsText.English="Help"/>
                </StackPanel></ScrollViewer>
            </Grid>
        </Border>
        <Grid x:Name="SettingsContent" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="24,24,24,20">
                <TextBlock x:Name="PageHeading" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageDescription" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,16">
                <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">
<Border x:Name="OutputSection" Visibility="Collapsed"><StackPanel>
<TextBlock Style="{StaticResource SectionTitle}" settings:SettingsText.Chinese="保存位置" settings:SettingsText.English="Save locations"/>
<Border Style="{StaticResource Card}"><StackPanel><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition/></Grid.ColumnDefinitions>
<TextBlock settings:SettingsText.Chinese="截图" settings:SettingsText.English="Screenshots" Margin="0,0,12,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
<Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBox x:Name="ScreenshotDirectoryBox" MinWidth="100" />
<Button x:Name="ChooseScreenshotFolderButton" Grid.Column="1" Margin="10,0,0,0" settings:SettingsText.Chinese="选择目录" settings:SettingsText.English="Browse" Click="ChooseScreenshotFolder_Click" />
<Button x:Name="OpenScreenshotFolderButton" Grid.Column="2" Margin="8,0,0,0" settings:SettingsText.Chinese="打开" settings:SettingsText.English="Open" Click="OpenScreenshotFolder_Click" />
</Grid></Grid><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition/></Grid.ColumnDefinitions>
<TextBlock settings:SettingsText.Chinese="长截图" settings:SettingsText.English="Scrolling captures" Margin="0,0,12,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
<Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBox x:Name="LongCaptureDirectoryBox" MinWidth="100" />
<Button x:Name="ChooseLongCaptureFolderButton" Grid.Column="1" Margin="10,0,0,0" settings:SettingsText.Chinese="选择目录" settings:SettingsText.English="Browse" Click="ChooseLongCaptureFolder_Click" />
<Button x:Name="OpenLongCaptureFolderButton" Grid.Column="2" Margin="8,0,0,0" settings:SettingsText.Chinese="打开" settings:SettingsText.English="Open" Click="OpenLongCaptureFolder_Click" />
</Grid></Grid><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition/></Grid.ColumnDefinitions>
<TextBlock settings:SettingsText.Chinese="录屏" settings:SettingsText.English="Recordings" Margin="0,0,12,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
<Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBox x:Name="RecordingDirectoryBox" MinWidth="100" />
<Button x:Name="ChooseRecordingFolderButton" Grid.Column="1" Margin="10,0,0,0" settings:SettingsText.Chinese="选择目录" settings:SettingsText.English="Browse" Click="ChooseRecordingFolder_Click" />
<Button x:Name="OpenRecordingFolderButton" Grid.Column="2" Margin="8,0,0,0" settings:SettingsText.Chinese="打开" settings:SettingsText.English="Open" Click="OpenRecordingFolder_Click" />
</Grid></Grid></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel>
<TextBlock Style="{StaticResource SectionTitle}" settings:SettingsText.Chinese="完成后的行为" settings:SettingsText.English="When a capture finishes"/>
<CheckBox x:Name="CopyToClipboardBox" settings:SettingsText.Chinese="完成后自动复制到剪贴板" settings:SettingsText.English="Automatically copy to clipboard when finished" Margin="0,0,0,6" /><CheckBox x:Name="BorderFeedbackBox" settings:SettingsText.Chinese="显示屏幕边框反馈" settings:SettingsText.English="Show screen border feedback" />
<TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
settings:SettingsText.Chinese="截图和长截图复制图片，录屏复制视频文件。关闭自动复制后仍保存文件，可从最近截取重新复制。Win+V 历史不显示视频文件，图片单项上限为 4 MB。"
settings:SettingsText.English="Screenshots and scrolling captures copy images; recordings copy video files. Files are saved even when automatic copying is off. Copy again from Recent captures. Win+V supports images up to 4 MB and does not show video files."/>
</StackPanel></Border></StackPanel></Border>
<Border x:Name="RecordingSection" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" settings:SettingsText.Chinese="录屏画质与流畅度" settings:SettingsText.English="Recording quality and smoothness" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" settings:SettingsText.Chinese="保留选区原始尺寸。保存设置后，下次录屏生效；正在录制的视频不受影响。" settings:SettingsText.English="Keeps the original selection size. Saved changes apply to the next recording; an active recording keeps its current settings." />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock settings:SettingsText.Chinese="录屏方案" settings:SettingsText.English="Preset" VerticalAlignment="Center" />
                            <ComboBox x:Name="RecordingPresetBox" Grid.Column="1" Margin="0,0,0,10" SelectionChanged="RecordingPreset_SelectionChanged">
                                <ComboBoxItem Tag="Balanced" settings:SettingsText.Chinese="日用平衡 · 60 fps" settings:SettingsText.English="Daily balanced · 60 fps" />
                                <ComboBoxItem Tag="High" settings:SettingsText.Chinese="清晰流畅 · 60 fps，较大文件" settings:SettingsText.English="High quality · 60 fps, larger files" />
                                <ComboBoxItem Tag="Custom" settings:SettingsText.Chinese="自定义" settings:SettingsText.English="Custom" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" settings:SettingsText.Chinese="目标帧率" settings:SettingsText.English="Target frame rate" VerticalAlignment="Center" />
                            <ComboBox x:Name="RecordingFrameRateBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" SelectionChanged="RecordingDetail_SelectionChanged">
                                <ComboBoxItem Tag="15" Content="15 fps" /><ComboBoxItem Tag="24" Content="24 fps" /><ComboBoxItem Tag="30" Content="30 fps" /><ComboBoxItem Tag="60" Content="60 fps" />
                            </ComboBox>
                            <TextBlock Grid.Row="2" settings:SettingsText.Chinese="画质与大小" settings:SettingsText.English="Quality and size" VerticalAlignment="Center" />
                            <ComboBox x:Name="RecordingQualityBox" Grid.Row="2" Grid.Column="1" SelectionChanged="RecordingDetail_SelectionChanged">
                                <ComboBoxItem Tag="Compact" settings:SettingsText.Chinese="省空间" settings:SettingsText.English="Smaller files" />
                                <ComboBoxItem Tag="Balanced" settings:SettingsText.Chinese="平衡" settings:SettingsText.English="Balanced" />
                                <ComboBoxItem Tag="High" settings:SettingsText.Chinese="高清晰度（原高码率）" settings:SettingsText.English="High quality (original high bitrate)" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="RecordingEstimateText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,12" />
                        <CheckBox x:Name="RecordingCursorBox" settings:SettingsText.Chinese="录入鼠标指针" settings:SettingsText.English="Include the mouse pointer" />
                        <CheckBox x:Name="RecordingSystemAudioBox" Margin="0,10,0,0" settings:SettingsText.Chinese="录入系统声音（不含麦克风）" settings:SettingsText.English="Include system audio (no microphone)" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,0" settings:SettingsText.Chinese="默认日用平衡。高清晰度保留原先的高码率；如果设备跟不上，可降低帧率。实际流畅度也受画面刷新和设备性能影响。" settings:SettingsText.English="Daily balanced is the default. High quality restores the original higher bitrate. Reduce the frame rate if your device cannot keep up. Actual smoothness also depends on screen updates and device performance." />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,0" settings:SettingsText.Chinese="录屏只保留选区提示框。若 Windows 不允许关闭整屏系统黄框，请在系统设置中允许，然后重启 ClipRay；其他正在捕获屏幕的应用也可能保留系统框。" settings:SettingsText.English="Recording keeps the selection outline. If Windows refuses to hide its full-screen border, allow it in system settings and restart ClipRay. Other active capture apps can also keep the system border visible." />
                        <Button HorizontalAlignment="Left" Margin="0,10,0,0" settings:SettingsText.Chinese="打开 Windows 截图边框设置" settings:SettingsText.English="Windows capture border settings" Click="OpenCaptureBorderSettings_Click" />
                    </StackPanel>
                </Border>
<Border x:Name="StartupSection" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
<Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
<TextBlock settings:SettingsText.Chinese="界面语言" settings:SettingsText.English="Interface language" VerticalAlignment="Center"/>
<ComboBox x:Name="InterfaceLanguageBox" Grid.Column="1" HorizontalAlignment="Right" Width="180" AutomationProperties.Name="Interface language"
                              ToolTip="跟随 Windows 显示语言，或保存手动选择 / Follow Windows display language or save a manual choice">
                        <ComboBoxItem Content="跟随 Windows / Auto" Tag="auto"/>
                        <ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>
</Grid>
                        <TextBlock Style="{StaticResource SectionTitle}" settings:SettingsText.Chinese="登录与启动" settings:SettingsText.English="Startup" />
                        <CheckBox x:Name="StartupBox" settings:SettingsText.Chinese="登录 Windows 后启动 ClipRay（当前用户）" settings:SettingsText.English="Start ClipRay when signing in to Windows (current user)" />
                        <TextBlock Margin="0,9,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run settings:SettingsText.Chinese="启动状态：" settings:SettingsText.English="Startup status: " /><Run x:Name="StartupStateText" Text="正在读取…" />
                        </TextBlock>
                        <TextBlock Margin="0,9,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   settings:SettingsText.Chinese="登录 Windows 后，ClipRay 会在托盘中运行。" settings:SettingsText.English="ClipRay runs in the tray after you sign in." />
                    </StackPanel>
                </Border>
<Border x:Name="HotkeysSection" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" settings:SettingsText.Chinese="快捷键" settings:SettingsText.English="Shortcuts" />
                        <TextBlock settings:SettingsText.Chinese="点击输入框后直接按组合键。主快捷键按 Backspace 恢复默认；备用快捷键按 Backspace 或 Delete 清空。部分全屏游戏会占用单键，建议使用组合键。" settings:SettingsText.English="Select a field and press a key combination. Backspace resets a primary shortcut; Backspace or Delete clears an alternate shortcut. Use combinations when full-screen games intercept single keys." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,-8,0,10" TextWrapping="Wrap" />
                        <TextBlock settings:SettingsText.Chinese="区域截图默认吸附外层窗口；按住 Ctrl 可临时吸附窗口内控件。" settings:SettingsText.English="Region capture snaps to windows by default. Hold Ctrl to snap to controls inside a window." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" settings:SettingsText.Chinese="主快捷键" settings:SettingsText.English="Primary shortcut" Foreground="#AEB8CB" FontWeight="SemiBold" Margin="8,0,10,5" />
                            <TextBlock Grid.Row="10" settings:SettingsText.Chinese="开始实时翻译" settings:SettingsText.English="Start live translation" VerticalAlignment="Center" />
                            <TextBox x:Name="StartLiveTranslationHotkeyBox" Grid.Row="10" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="StartLiveTranslationSecondaryHotkeyBox" Grid.Row="10" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="11" settings:SettingsText.Chinese="停止实时翻译" settings:SettingsText.English="Stop live translation" VerticalAlignment="Center" />
                            <TextBox x:Name="StopLiveTranslationHotkeyBox" Grid.Row="11" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="StopLiveTranslationSecondaryHotkeyBox" Grid.Row="11" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Column="2" settings:SettingsText.Chinese="备用快捷键（可选）" settings:SettingsText.English="Alternate shortcut (optional)" TextWrapping="Wrap" Foreground="#AEB8CB" FontWeight="SemiBold" Margin="8,0,0,5" />

                            <TextBlock Grid.Row="1" settings:SettingsText.Chinese="区域截图" settings:SettingsText.English="Capture region" VerticalAlignment="Center" />
                            <TextBox x:Name="RegionHotkeyBox" Grid.Row="1" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="RegionSecondaryHotkeyBox" Grid.Row="1" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="2" settings:SettingsText.Chinese="全屏截图（不含任务栏）" settings:SettingsText.English="Capture screen (without taskbar)" VerticalAlignment="Center" />
                            <TextBox x:Name="CurrentHotkeyBox" Grid.Row="2" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="CurrentSecondaryHotkeyBox" Grid.Row="2" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="3" settings:SettingsText.Chinese="全屏截图（含任务栏）" settings:SettingsText.English="Capture screen (with taskbar)" VerticalAlignment="Center" />
                            <TextBox x:Name="TaskbarFreeCurrentHotkeyBox" Grid.Row="3" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="TaskbarFreeCurrentSecondaryHotkeyBox" Grid.Row="3" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="4" settings:SettingsText.Chinese="完整虚拟桌面" settings:SettingsText.English="Capture all screens" VerticalAlignment="Center" />
                            <TextBox x:Name="DesktopHotkeyBox" Grid.Row="4" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="DesktopSecondaryHotkeyBox" Grid.Row="4" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="5" settings:SettingsText.Chinese="开始录屏" settings:SettingsText.English="Start recording" VerticalAlignment="Center" />
                            <TextBox x:Name="StartRecordingHotkeyBox" Grid.Row="5" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="StartRecordingSecondaryHotkeyBox" Grid.Row="5" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="6" settings:SettingsText.Chinese="停止录屏" settings:SettingsText.English="Stop recording" VerticalAlignment="Center" />
                            <TextBox x:Name="StopRecordingHotkeyBox" Grid.Row="6" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="StopRecordingSecondaryHotkeyBox" Grid.Row="6" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="7" settings:SettingsText.Chinese="确认截图" settings:SettingsText.English="Confirm capture" VerticalAlignment="Center" />
                            <TextBox x:Name="ConfirmCaptureHotkeyBox" Grid.Row="7" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="ConfirmCaptureSecondaryHotkeyBox" Grid.Row="7" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="8" settings:SettingsText.Chinese="双按退出键取消" settings:SettingsText.English="Press exit key twice to cancel" VerticalAlignment="Center" />
                            <TextBox x:Name="CancelCaptureHotkeyBox" Grid.Row="8" Grid.Column="1" Margin="8,4,10,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBox x:Name="CancelCaptureSecondaryHotkeyBox" Grid.Row="8" Grid.Column="2" Margin="8,4,0,4" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <TextBlock Grid.Row="9" settings:SettingsText.Chinese="停止长截图" settings:SettingsText.English="Stop scrolling capture" VerticalAlignment="Center" />
